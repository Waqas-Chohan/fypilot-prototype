# Copy to backend/.env and fill in real values (backend/.env is git-ignored).
JWT_SECRET_KEY=change-me-to-a-long-random-string
SECRET_KEY=change-me-too
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fypilot

# --- Activity 7 ---------------------------------------------------------
# Access token lifetime; the refresh token lives for SESSION_TTL_DAYS.
ACCESS_TTL_MINUTES=15
SESSION_TTL_DAYS=7
# TEST ONLY. Enables the X-Fault-Inject header used to prove that a failed
# audit write rolls the whole transaction back. Never enable in production.
ALLOW_FAULT_INJECTION=false
